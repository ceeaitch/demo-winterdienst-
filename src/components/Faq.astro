---
/**
 * FAQ als native <details>-Elemente: funktioniert ohne JavaScript, ist
 * barrierefrei und der Text steht im HTML (für Google & KI lesbar).
 * Das passende FAQPage-Schema erzeugt die jeweilige Seite.
 */
interface Props {
  items: readonly { q: string; a: string }[];
  title?: string;
  eyebrow?: string;
  id?: string;
}
const { items, title = 'Häufige Fragen zum Winterdienst', eyebrow = 'FAQ', id = 'faq' } = Astro.props;
---

<section class="section faq" id={id}>
  <div class="container-narrow">
    <header class="section-head center" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </header>
    <div class="faq-list" data-reveal-stagger>
      {
        items.map((item, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>
              <h3>{item.q}</h3>
              <span class="faq-icon" aria-hidden="true" />
            </summary>
            <div class="faq-answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-list {
    display: grid;
    gap: 0.75rem;
  }

  .faq-item {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      border-color 0.3s,
      background 0.3s;
    interpolate-size: allow-keywords;
  }

  .faq-item[open] {
    border-color: var(--border-strong);
    background: var(--surface-2);
  }

  /* Weiches Auf-/Zuklappen in modernen Browsern */
  .faq-item::details-content {
    height: 0;
    overflow: clip;
    transition:
      height 0.45s var(--ease-out),
      content-visibility 0.45s allow-discrete;
  }

  .faq-item[open]::details-content {
    height: auto;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.2rem 1.4rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary h3 {
    margin: 0;
    font-size: clamp(1.02rem, 0.98rem + 0.25vw, 1.15rem);
    font-weight: 600;
    line-height: 1.4;
  }

  .faq-icon {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 1.6px;
    background: var(--ice);
    transform: translate(-50%, -50%);
    transition: transform 0.35s var(--ease-out);
  }

  .faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq-item[open] .faq-icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq-answer {
    padding: 0 1.4rem 1.3rem;
    color: var(--text-2);
  }

  .faq-answer p {
    margin: 0;
  }
</style>
