---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Snowfall from './Snowfall.astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  compact?: boolean;
}

const { eyebrow, title, lead, image, imageAlt = '', compact = false } = Astro.props;
---

<section class:list={['page-hero', { 'has-image': image, compact }]} data-parallax-root>
  {
    image && (
      <div class="ph-media" data-parallax="0.18">
        <Image src={image} alt={imageAlt} widths={[640, 1024, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" quality={70} />
      </div>
    )
  }
  <div class="ph-overlay" aria-hidden="true"></div>
  {image && <Snowfall />}
  <div class="container ph-inner">
    <p class="eyebrow ph-anim" style="--d: 0s">{eyebrow}</p>
    <h1 class="ph-anim" style="--d: 0.1s">{title}</h1>
    {
      lead && (
        <p class="lead ph-anim" style="--d: 0.22s">
          {lead}
        </p>
      )
    }
    <div class="ph-actions ph-anim" style="--d: 0.34s">
      <slot />
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: calc(var(--header-h) + 130px) 0 clamp(64px, 9vw, 120px);
  }

  .page-hero.has-image {
    min-height: min(78svh, 760px);
    display: flex;
    align-items: flex-end;
  }

  .page-hero.compact {
    padding-bottom: clamp(32px, 5vw, 56px);
  }

  .ph-media {
    position: absolute;
    inset: -6% 0 0;
    z-index: -2;
  }

  .ph-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ph-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(80% 60% at 80% 0%, rgb(56 189 248 / 0.14), transparent 60%),
      linear-gradient(180deg, transparent 0%, var(--bg) 100%);
  }

  .has-image .ph-overlay {
    background:
      linear-gradient(90deg, rgb(5 10 22 / 0.92) 0%, rgb(5 10 22 / 0.6) 60%, rgb(5 10 22 / 0.35) 100%),
      linear-gradient(0deg, var(--bg) 0%, transparent 50%);
  }

  .ph-inner {
    position: relative;
    z-index: 2;
  }

  h1 {
    max-width: 960px;
    font-size: clamp(2.1rem, 1.3rem + 3.4vw, 4rem);
  }

  .lead {
    max-width: 760px;
  }

  .ph-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.6rem;
  }

  .ph-actions:empty {
    display: none;
  }

  .ph-anim {
    animation: ph-rise 1.1s var(--ease-out) both;
    animation-delay: calc(var(--d, 0s) + 0.1s);
  }

  @keyframes ph-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
      filter: blur(6px);
    }
  }
</style>
