---
import { withBase } from '../lib/site';

interface Props {
  items: { name: string; path: string }[];
}
const { items } = Astro.props;
---

<nav class="breadcrumbs container" aria-label="Brotkrumen-Navigation">
  <ol>
    {
      items.map((item, i) => (
        <li>
          {i < items.length - 1 ? (
            <a href={withBase(item.path)}>{item.name}</a>
          ) : (
            <span aria-current="page">{item.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  /* liegt über dem Seitenkopf (PageHero), damit es auch über Bildern sitzt */
  .breadcrumbs {
    position: absolute;
    z-index: 3;
    top: calc(var(--header-h) + 64px);
    left: 0;
    right: 0;
  }

  :global(main) {
    position: relative;
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  li:not(:last-child)::after {
    content: '/';
    margin-left: 0.4rem;
    opacity: 0.5;
  }

  a {
    color: var(--text-2);
    text-decoration: none;
  }

  a:hover {
    color: var(--ice);
  }

  [aria-current] {
    color: var(--text);
  }
</style>
