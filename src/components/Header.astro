---
import { company } from '../data/company';
import { withBase } from '../lib/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const nav = [
  { href: '/leistungen/winterdienst-gewerbe/', label: 'Leistungen' },
  { href: '/einsatzgebiet/', label: 'Einsatzgebiet' },
  { href: '/ratgeber/raeumpflicht-krefeld/', label: 'Ratgeber' },
  { href: '/#rechner', label: 'Preise' },
  { href: '/kontakt/', label: 'Kontakt' },
];

const current = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && current.startsWith(withBase(href));
---

<header class="site-header" data-header>
  <!-- Saison-Banner: wechselt im Demo-Modus „Frostnacht“ auf Glättewarnung -->
  <div class="season-bar">
    <div class="container season-inner">
      <p class="season-normal">
        <Icon name="snowflake" size={15} />
        <span class="season-long"><strong>{company.season.label}</strong> startet am {company.season.start}. Die Tourenplanung läuft.</span>
        <span class="season-short"><strong>{company.season.label}</strong> ab 1. November</span>
        <a href={withBase('/#anfrage')}>Platz sichern <span aria-hidden="true">→</span></a>
      </p>
      <p class="season-frost">
        <Icon name="alert" size={15} />
        <span><strong>Glättewarnung Krefeld:</strong> Unsere Teams sind unterwegs. <em>(Simulation)</em></span>
      </p>
    </div>
  </div>

  <div class="header-main">
    <div class="container header-inner">
      <a href={withBase('/')} class="brand" aria-label={`${company.name} – zur Startseite`}>
        <Logo />
      </a>

      <nav class="main-nav" id="main-nav" aria-label="Hauptnavigation">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="nav-mobile-extra">
          <a class="btn btn-primary btn-lg" href={withBase('/#anfrage')}>Angebot anfordern</a>
          <a class="btn btn-ghost btn-lg" href={`tel:${company.phone}`}>
            <Icon name="phone" size={18} /> {company.phoneDisplay}
          </a>
        </div>
      </nav>

      <div class="header-actions">
        <a class="header-phone" href={`tel:${company.phone}`} aria-label={`Anrufen: ${company.phoneDisplay}`}>
          <Icon name="phone" size={17} />
          <span>{company.phoneDisplay}</span>
        </a>
        <a class="btn btn-primary btn-sm header-cta" href={withBase('/#anfrage')}>Angebot anfordern</a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Menü öffnen">
          <span class="nav-toggle-open"><Icon name="menu" /></span>
          <span class="nav-toggle-close"><Icon name="x" /></span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    transition: transform 0.5s var(--ease-out);
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  /* --- Saison-Banner --- */
  .season-bar {
    background: linear-gradient(90deg, rgb(14 165 233 / 0.22), rgb(59 130 246 / 0.12));
    border-bottom: 1px solid var(--border);
    font-size: 0.84rem;
    overflow: hidden;
    max-height: 60px;
    transition:
      max-height 0.45s var(--ease-out),
      opacity 0.3s;
  }

  .is-scrolled .season-bar {
    max-height: 0;
    opacity: 0;
  }

  .season-inner p {
    margin: 0;
    padding: 0.5rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--text-2);
    text-align: center;
  }

  .season-inner :global(svg) {
    flex: none;
    color: var(--ice);
  }

  .season-inner a {
    font-weight: 600;
    white-space: nowrap;
  }

  .season-frost,
  .season-short {
    display: none !important;
  }

  :global([data-frost='on']) .season-bar {
    background: linear-gradient(90deg, rgb(251 113 133 / 0.3), rgb(251 191 36 / 0.16));
  }

  :global([data-frost='on']) .season-normal {
    display: none !important;
  }

  :global([data-frost='on']) .season-frost {
    display: flex !important;
  }

  :global([data-frost='on']) .season-frost :global(svg) {
    color: var(--warn);
  }

  /* --- Hauptleiste --- */
  .header-main {
    transition:
      background 0.4s,
      border-color 0.4s,
      backdrop-filter 0.4s;
    border-bottom: 1px solid transparent;
  }

  .is-scrolled .header-main,
  .menu-open .header-main {
    background: rgb(5 10 22 / 0.78);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border-color: var(--border);
  }

  .header-inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .brand {
    text-decoration: none;
    flex: none;
  }

  .main-nav {
    margin-left: auto;
  }

  .main-nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .main-nav ul a {
    display: block;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    color: var(--text-2);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition:
      color 0.25s,
      background 0.25s;
  }

  .main-nav ul a:hover,
  .main-nav ul a[aria-current='page'] {
    color: var(--text);
    background: var(--surface-2);
  }

  .nav-mobile-extra {
    display: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .header-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    white-space: nowrap;
  }

  .header-phone :global(svg) {
    color: var(--ice);
  }

  .nav-toggle {
    display: none;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    place-items: center;
  }

  .nav-toggle-close {
    display: none;
  }

  .menu-open .nav-toggle-open {
    display: none;
  }

  .menu-open .nav-toggle-close {
    display: block;
  }

  @media (max-width: 1100px) {
    .header-phone span {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .season-long {
      display: none !important;
    }

    .season-short {
      display: inline !important;
    }

    .season-inner p {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 960px) {
    .nav-toggle {
      display: grid;
    }

    .header-cta {
      display: none;
    }

    /* Wichtig: backdrop-filter würde das fixierte Menü an den Header binden
       (eigener Bezugsrahmen) – bei offenem Menü daher ohne Filter */
    .menu-open .header-main {
      background: var(--bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .main-nav {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      top: calc(var(--header-h) + var(--season-h, 0px));
      background: var(--bg);
      padding: 2rem var(--gutter) 6rem;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-12px);
      transition:
        opacity 0.35s var(--ease-out),
        transform 0.35s var(--ease-out),
        visibility 0.35s;
      overflow-y: auto;
    }

    .menu-open .main-nav {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .main-nav ul {
      flex-direction: column;
      gap: 0.25rem;
    }

    .main-nav ul a {
      font-family: var(--font-display);
      font-size: 1.6rem;
      font-weight: 600;
      padding: 0.7rem 0;
      background: none;
      border-bottom: 1px solid var(--border);
      border-radius: 0;
    }

    .nav-mobile-extra {
      display: grid;
      gap: 0.75rem;
      margin-top: 2rem;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = header?.querySelector<HTMLElement>('#main-nav');

  function setMenu(open: boolean) {
    if (!header || !toggle) return;
    header.classList.toggle('menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    const bar = header.querySelector<HTMLElement>('.season-bar');
    header.style.setProperty('--season-h', `${bar?.offsetHeight ?? 0}px`);
    if (open) window.lenis?.stop();
    else window.lenis?.start();
    document.body.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setMenu(!header?.classList.contains('menu-open')));
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('menu-open')) {
      setMenu(false);
      toggle?.focus();
    }
  });
</script>
