</style>

<script>
  // Inhaltsverzeichnis: aktiven Abschnitt hervorheben
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((a) => links.set(a.dataset.tocLink!, a));
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          links.forEach((a) => a.classList.remove('is-active'));
          links.get(e.target.id)?.classList.add('is-active');
        }
      });
    },
    { rootMargin: '-20% 0px -70% 0px' },
  );
  links.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });

  // Checkliste mit Fortschritt
  const box = document.querySelector<HTMLElement>('[data-checkliste]');
  if (box) {
    const items = [...box.querySelectorAll<HTMLInputElement>('[data-cl-item]')];
    const update = () => {
      const done = items.filter((i) => i.checked).length;
      box.querySelector('[data-cl-done]')!.textContent = String(done);
      box.querySelector<HTMLElement>('[data-cl-bar]')!.style.width = `${(done / items.length) * 100}%`;
      const msg = box.querySelector<HTMLElement>('[data-cl-msg]')!;
      msg.classList.toggle('is-complete', done === items.length);
      msg.textContent =
        done === items.length
          ? 'Sehr gut – Ihr Betrieb ist winterfest aufgestellt.'
          : `${items.length - done} offene Punkte = ${items.length - done} Haftungsrisiken. Wir übernehmen die Punkte 1 bis 7 für Sie.`;
    };
    items.forEach((i) => i.addEventListener('change', update));
  }
</script>
